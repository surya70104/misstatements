# Copy to backend\.env and replace every CHANGE_ME. backend\.env is ignored by git: never
# commit it, and never put a real password in this example file.
#
# Every name starts with OAK_. The application refuses any database other than
# oak_misstatements and oak_misstatements_test, any host other than localhost, and any role
# other than the one each URL is for, so nothing here can point at another module's database
# (architecture D5).

OAK_ENV=development

# The API connects as oak_misstatements_app: least privilege, no DDL, and no UPDATE or DELETE
# on the append-only tables. Host and port must be explicit.
OAK_DATABASE_URL=postgresql+psycopg://oak_misstatements_app:CHANGE_ME@localhost:5432/oak_misstatements

# Alembic migrations connect as oak_misstatements_owner.
OAK_MIGRATION_DATABASE_URL=postgresql+psycopg://oak_misstatements_owner:CHANGE_ME@localhost:5432/oak_misstatements

# Database tests: only the database oak_misstatements_test is accepted. Leave both unset to
# skip the tests marked "db". The owner URL migrates and inserts; the app URL proves that the
# application role cannot update or delete append-only rows.
# OAK_TEST_DATABASE_URL=postgresql+psycopg://oak_misstatements_owner:CHANGE_ME@localhost:5432/oak_misstatements_test
# OAK_TEST_APP_DATABASE_URL=postgresql+psycopg://oak_misstatements_app:CHANGE_ME@localhost:5432/oak_misstatements_test

# Who is acting (architecture D7). OAK_AUTH=dev records OAK_DEV_USER on every action;
# development and tests only, refused when OAK_ENV=production. OAK_AUTH=header takes the
# identity from the header an authenticating reverse proxy sets on every request; the module
# verifies nothing itself, so the proxy must be the only route in.
OAK_AUTH=dev
OAK_DEV_USER=dev@localhost
# OAK_AUTH_HEADER=X-Authenticated-User
# In header mode the header is believed only from these peer addresses (IPs or networks,
# comma-separated); required when OAK_ENV=production. Run uvicorn without --proxy-headers.
# OAK_TRUSTED_PROXIES=10.0.0.5, 10.0.1.0/24
# The role claim (architecture D39, D40; pending decision B9). Partner-only actions (the
# soft-gate acknowledgement) succeed only when OAK_TRUSTED_PROXIES lists the proxy, the proxy
# presents the signed-in user's roles, comma-separated, in this header (replacing any value
# a client sent, exactly one header), and the value below is among them as a whole value.
# Both or neither; read only in header mode. Without all three, every partner-only action
# fails closed (403) and writes nothing.
# OAK_AUTH_ROLES_HEADER=X-Authenticated-Roles
# OAK_PARTNER_ROLE=CHANGE_ME

# The gate at performance materiality (spec section 7; architecture D12): "soft" is the
# standard's own test, a warning and a required partner acknowledgement; "hard" blocks.
OAK_PM_GATE=soft

# The strategy trigger (spec section 7; SA 450 paragraph 6): the fraction of overall
# materiality at which the aggregate is "approaching materiality" and the prompt to revisit
# the audit strategy fires. No default: the band is pending decision B5. Unset, the trigger
# is not evaluated and every evaluation says so. A value above 0 and below 1.
# OAK_STRATEGY_TRIGGER_FRACTION=CHANGE_ME

# The Financial Spine (architecture D11): its service root. Unset means no Spine; every
# Spine-dependent action says so instead of failing. Production requires https:// unless the
# Spine is on the loopback interface. The credential is optional and never printed.
# OAK_SPINE_URL=http://127.0.0.1:8000
# OAK_SPINE_CREDENTIAL=CHANGE_ME

# The Working Paper Binder (Pass 2, the generated binder paper) and WorkMind (Pass 2, agent
# run intake). Unset means not configured.
# OAK_BINDER_URL=http://127.0.0.1:8001
# OAK_BINDER_CREDENTIAL=CHANGE_ME
# OAK_WORKMIND_URL=http://127.0.0.1:8002
# OAK_WORKMIND_CREDENTIAL=CHANGE_ME
